# Apple App Store billing identity. Keep real values outside Git.
APP_STORE_APPLE_ID=
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY_LOCAL_FILE=
APP_STORE_ROOT_CERTIFICATES_LOCAL_DIR=

# Dedicated Telegram admin bot for the Apple production stack.
ADMIN_BOT_TOKEN=
